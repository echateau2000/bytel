.slot{min-height:0;margin-bottom:10px}
.bn{display:flex;gap:10px;justify-content:space-between;align-items:center;flex-wrap:wrap;padding:10px 12px;border-radius:6px;background:var(--accent-soft);border-left:4px solid var(--accent);animation:drop .45s ease both}
