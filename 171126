.win .top b{width:9px;height:9px;border-radius:50%;background:var(--line)}
.win .url{flex:1;margin-left:8px;background:var(--surface);border:1px solid var(--line);border-radius:99px;padding:2px 10px;font:500 .7rem var(--mono);color:var(--muted);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.page{position:relative;padding:14px;min-height:260px;font-size:.88rem}
.page h4{font-size:1.02rem;margin-bottom:10px}
