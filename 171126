<script>
(function(){
  var root=document.documentElement;root.classList.add('js');
  var sl=[].slice.call(document.querySelectorAll('.slide')),cur=-1,dots=document.getElementById('dots'),cnt=document.getElementById('cnt'),pv=document.getElementById('prev'),nx=document.getElementById('next');
  sl.forEach(function(el,i){var d=document.createElement('button');d.setAttribute('aria-label',el.dataset.name);d.title=el.dataset.name;d.addEventListener('click',function(){go(i)});dots.appendChild(d)});
  function go(i,fromHash){
    i=Math.max(0,Math.min(sl.length-1,i));if(i===cur)return;
    var back=i<cur;
    sl.forEach(function(el,k){el.classList.remove('on','back');if(k===i){el.classList.add('on');if(back)el.classList.add('back');el.scrollTop=0}});
    [].forEach.call(dots.children,function(d,k){d.className=k===i?'on':''});
    cnt.textContent=(i+1)+' / '+sl.length;pv.disabled=i===0;nx.disabled=i===sl.length-1;
    cur=i;
    if(!fromHash){try{history.replaceState(null,'','#'+sl[i].id)}catch(e){location.hash=sl[i].id}}
    document.title='Personnalisation omnicanale Bytel';
  }
  function fromHash(){var h=(location.hash||'').replace('#','');var k=sl.map(function(e){return e.id}).indexOf(h);go(k>-1?k:0,true)}
  pv.addEventListener('click',function(){go(cur-1)});nx.addEventListener('click',function(){go(cur+1)});
  document.querySelectorAll('[data-go]').forEach(function(b){b.addEventListener('click',function(){var k=sl.map(function(e){return e.id}).indexOf(b.dataset.go);if(k>-1)go(k)})});
  document.addEventListener('keydown',function(e){
    if(e.metaKey||e.ctrlKey||e.altKey)return;
    var k=e.key;
    if(k==='ArrowRight'||k==='PageDown'||(k===' '&&!/BUTTON/.test((document.activeElement||{}).tagName||''))){e.preventDefault();go(cur+1)}
    else if(k==='ArrowLeft'||k==='PageUp'){e.preventDefault();go(cur-1)}
    else if(k==='Home'){e.preventDefault();go(0)}
    else if(k==='End'){e.preventDefault();go(sl.length-1)}
  });
  var x0=null,y0=null;
  document.addEventListener('touchstart',function(e){x0=e.touches[0].clientX;y0=e.touches[0].clientY},{passive:true});
  document.addEventListener('touchend',function(e){if(x0===null)return;var dx=e.changedTouches[0].clientX-x0,dy=e.changedTouches[0].clientY-y0;x0=null;
    if(Math.abs(dx)>60&&Math.abs(dx)>Math.abs(dy)*1.5){go(dx<0?cur+1:cur-1)}},{passive:true});
  window.addEventListener('hashchange',fromHash);
  fromHash();
})();
</script>

