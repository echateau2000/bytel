    var m=document.createElementNS(NS,'animateMotion');m.setAttribute('dur','4s');m.setAttribute('repeatCount','indefinite');m.setAttribute('calcMode','linear');
    m.setAttribute('keyPoints',kp);m.setAttribute('keyTimes',kt);m.setAttribute('begin',delay+'s');
    var mp=document.createElementNS(NS,'mpath');mp.setAttributeNS('http://www.w3.org/1999/xlink','href','#'+id);mp.setAttribute('href','#'+id);m.appendChild(mp);
    var a=document.createElementNS(NS,'animate');a.setAttribute('attributeName','opacity');a.setAttribute('dur','4s');a.setAttribute('repeatCount','indefinite');
    a.setAttribute('values',op);a.setAttribute('keyTimes',opt);a.setAttribute('begin',delay+'s');
    c.appendChild(m);c.appendChild(a);g.appendChild(c);
  }
  ['p1','p2','p3'].forEach(function(id,i){pk(id,'pk-in','0;1;1','0;0.38;1','0;1;1;0;0','0;0.03;0.36;0.4;1',(i*0.12).toFixed(2))});
