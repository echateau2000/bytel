.replay:hover,.seg button:hover{filter:brightness(.97)}
:focus-visible{outline:2px solid var(--accent);outline-offset:2px}
.path{display:flex;flex-wrap:wrap;gap:6px;align-items:center;padding:0 20px 14px;font:500 .74rem var(--mono);letter-spacing:.03em}
