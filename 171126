.pgrid{display:grid;grid-template-columns:repeat(3,1fr);gap:8px}
.pcard{border:1px solid var(--line);border-radius:6px;padding:8px;text-align:center;font-size:.8rem}
.pcard i{display:block;height:56px;border-radius:4px;background:var(--bg);margin-bottom:6px}
.pcard.sel{border-color:var(--accent);box-shadow:0 0 0 2px var(--accent-soft)}
.inp{border:1px solid var(--line);border-radius:5px;padding:9px 10px;min-height:38px;background:var(--surface);font-size:.85rem}
