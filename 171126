  --mono:"IBM Plex Mono",ui-monospace,Menlo,monospace;
}
@media (prefers-color-scheme: dark){:root:not([data-theme="light"]){
  --bg:#0D151C; --surface:#15212B; --ink:#E8EEF3; --muted:#93A5B4; --line:#263543;
  --accent:#5CB8E2; --accent-soft:#12303F; --warm:#F0A55B; --warm-soft:#33240F; --good:#4FC595; --good-soft:#123327;
  --hero:#081821; --hero-ink:#F2F7FA; --hero-muted:#86A2B3; --on-fill:#06131B; color-scheme:dark}}
:root[data-theme="dark"]{
  --bg:#0D151C; --surface:#15212B; --ink:#E8EEF3; --muted:#93A5B4; --line:#263543;
  --accent:#5CB8E2; --accent-soft:#12303F; --warm:#F0A55B; --warm-soft:#33240F; --good:#4FC595; --good-soft:#123327;
  --hero:#081821; --hero-ink:#F2F7FA; --hero-muted:#86A2B3; --on-fill:#06131B; color-scheme:dark}
*{box-sizing:border-box}
body{background:var(--bg);color:var(--ink);font:16px/1.55 var(--body);margin:0;
  padding-left:max(16px,env(safe-area-inset-left,0px));padding-right:max(16px,env(safe-area-inset-right,0px))}
.wrap{max-width:1080px;margin:0 auto}
