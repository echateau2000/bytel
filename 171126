.desk{border:1px solid var(--line);border-radius:8px;background:var(--surface);min-height:300px;display:flex;flex-direction:column;overflow:hidden}
.desk .hd{background:var(--ink);color:var(--bg);font:500 .68rem var(--mono);letter-spacing:.06em;padding:8px 10px}
