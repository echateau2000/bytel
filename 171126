.cursor{position:absolute;width:20px;height:20px;z-index:4;pointer-events:none;opacity:0;transition:left .8s cubic-bezier(.5,0,.2,1),top .8s cubic-bezier(.5,0,.2,1),opacity .3s}
.cursor svg{width:20px;height:20px;filter:drop-shadow(0 1px 1px rgba(0,0,0,.35))}
.cursor.show{opacity:1}
.ripple{position:absolute;width:30px;height:30px;margin:-10px 0 0 -10px;border-radius:50%;border:2px solid var(--accent);z-index:3;pointer-events:none;animation:rip .6s ease-out forwards}
