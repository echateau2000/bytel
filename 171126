.clock{position:absolute;top:-12px;right:20px;z-index:5;font:500 .8rem var(--mono);background:var(--ink);color:var(--bg);padding:5px 10px;border-radius:99px;transition:transform .3s}
.clock.pop{transform:scale(1.12)}
.paneTitle{font:500 .68rem var(--mono);letter-spacing:.09em;text-transform:uppercase;color:var(--muted);margin-bottom:6px}
